#!/bin/sh
# Play the game, and keep it current without being asked.
#
# Starts the board and then watches the branch. When a change is pushed, this
# pulls it, rebuilds, and restarts the server; the page notices the build
# stamp move and reloads itself. So the terminal becomes a thing you start
# once and leave alone, rather than a sequence to repeat every time something
# changes.
#
#   ./play              start, and follow the branch from then on
#   ./play --once       start what is checked out, and do not watch
#   ./play --port 9000  any option the game itself takes still works
#   ./play --demo 6     have six played games to read the analytics of
#
# `--demo N` is a floor rather than a tally, so it can sit in the command you
# leave running: a restart tops the store up to N rather than adding N more.
set -e
cd "$(dirname "$0")"

# cargo lives in ~/.cargo/bin, which a fresh shell may not have on PATH.
[ -x "$HOME/.cargo/bin/cargo" ] && PATH="$HOME/.cargo/bin:$PATH"
if ! command -v cargo > /dev/null; then
  echo "cargo not found — install Rust with:" >&2
  echo "  curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y" >&2
  exit 1
fi

WATCH=yes
if [ "$1" = "--once" ]; then
  WATCH=no
  shift                        # not an option the game itself understands
fi

# Report the port actually asked for, not the default.
PORT=8181
prev=""
for arg in "$@"; do
  [ "$prev" = "--port" ] && PORT="$arg"
  prev="$arg"
done
URL=http://127.0.0.1:$PORT

GAME=""
stop() {
  [ -n "$GAME" ] && kill "$GAME" 2> /dev/null
  GAME=""
}
trap 'stop; exit 0' INT TERM

start() {
  # Stop anything already serving, so the port is free and an old build cannot
  # be mistaken for the new one.
  stop
  pkill -x carranta-play 2> /dev/null || true
  cargo build --release -p carranta-ui
  ./target/release/carranta-play "$@" &
  GAME=$!
  sleep 1
}

git pull --ff-only
start "$@"
command -v open > /dev/null && open "$URL"
echo
echo "Playing at $URL  ·  build $(git rev-parse --short HEAD)"
if [ "$WATCH" = yes ]; then
  echo "Watching for changes — they will appear by themselves."
else
  echo "Not watching; run ./play again to pick up changes."
fi
echo "Press ctrl-c to stop."

if [ "$WATCH" != yes ]; then
  wait $GAME
  exit 0
fi

BRANCH=$(git rev-parse --abbrev-ref HEAD)
while true; do
  sleep 30
  # A laptop loses its network all the time; that is not worth reporting, and
  # the next pass picks up whatever was missed.
  if git fetch --quiet origin "$BRANCH" 2> /dev/null \
    && [ "$(git rev-parse HEAD)" != "$(git rev-parse FETCH_HEAD)" ]; then
    echo
    echo "New change — pulling and rebuilding."
    if git pull --ff-only --quiet; then
      start "$@"
      echo "Now on build $(git rev-parse --short HEAD). The page reloads itself."
    else
      echo "Could not fast-forward; leaving the running build alone." >&2
    fi
  fi
  # If the server died on its own, put it back.
  if ! kill -0 "$GAME" 2> /dev/null; then
    echo "Server stopped — restarting."
    start "$@"
  fi
done
